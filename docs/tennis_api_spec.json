{
  "api_name": "API Tennis",
  "version": "2.9.4",
  "base_url": "https://api.api-tennis.com/tennis/",
  "documentation_purpose": "Real-time tennis data API specification for LLM consumption.",
  "authentication": {
    "type": "API Key",
    "param_name": "APIkey",
    "required": true,
    "description": "Authorization code generated from your API Tennis account."
  },
  "global_rules": {
    "supported_http_methods": [
      "GET",
      "POST"
    ],
    "default_timezone": "Europe/Berlin",
    "timezone_format_example": "America/New_York",
    "parameter_conventions": {
      "method": "Required on every request and selects the API endpoint.",
      "APIkey": "Required on every request.",
      "date_start": "Format YYYY-MM-DD.",
      "date_stop": "Format YYYY-MM-DD."
    },
    "null_and_empty_values": [
      "null",
      "-",
      ""
    ],
    "interpretation_rules": [
      "Treat null, '-', and empty strings as missing data.",
      "Preserve nested arrays such as pointbypoint and scores unless explicitly asked to flatten them.",
      "Do not invent fields that are not present in the documentation.",
      "Use the provided timezone parameter when present; otherwise assume the documented default timezone.",
      "Identifiers such as event_key, tournament_key, player_key, and event_type_key should be treated as unique IDs in their respective domains."
    ]
  },
  "entity_glossary": {
    "event_type_key": "Unique identifier for a tournament/event type (for example ATP Singles).",
    "tournament_key": "Unique identifier for a specific tournament.",
    "event_key": "Unique identifier for a specific match or fixture.",
    "player_key": "Unique identifier for a player."
  },
  "endpoints": [
    {
      "method": "get_events",
      "title": "Events Types",
      "description": "Returns the list of supported tournament types included in the current subscription plan.",
      "request": {
        "path": "/?method=get_events&APIkey={APIkey}",
        "example_url": "https://api.api-tennis.com/tennis/?method=get_events&APIkey=!_your_account_APIkey_!",
        "http_methods_supported": [
          "GET",
          "POST"
        ],
        "required_params": [
          "method",
          "APIkey"
        ],
        "optional_params": []
      },
      "response": {
        "success_type": "integer",
        "result_type": "array",
        "item_type": "object",
        "item_schema": {
          "event_type_key": "string",
          "event_type_type": "string"
        }
      },
      "example_response": {
        "success": 1,
        "result": [
          {
            "event_type_key": "267",
            "event_type_type": "Atp Doubles"
          },
          {
            "event_type_key": "265",
            "event_type_type": "Atp Singles"
          },
          {
            "event_type_key": "281",
            "event_type_type": "Challenger Men Singles"
          }
        ]
      }
    },
